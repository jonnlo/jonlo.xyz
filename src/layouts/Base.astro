---
import '../styles/global.css';
interface Props { title?: string; description?: string; section?: 'journal' | 'about'; noindex?: boolean; }
const { title = 'Jon’s log', description = 'A personal archive of essays, notes and recurring thoughts.', section = 'journal', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const configuredSite = Astro.site && !['localhost', '127.0.0.1'].includes(Astro.site.hostname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('journal-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <title>{title === 'Jon’s log' ? title : `${title} — Jon’s log`}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {configuredSite && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {configuredSite && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Jon’s log" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="header">
        <a class="identity" href="/">Jon’s log</a>
        <nav aria-label="Main navigation"><a href="/" aria-current={section === 'journal' ? 'page' : undefined}>Entries</a><a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>About</a><button class="theme-toggle" type="button" aria-label="Switch to dark appearance" title="Switch to dark appearance" data-next-theme="dark"><span class="theme-symbol" aria-hidden="true">◐</span></button></nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer><span>personal archive / ongoing · <time datetime="2026">2026—</time></span><div class="footer-links"><a href="/feed.xml">RSS ↗</a></div></footer>
    </div>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      const updateThemeButton = () => {
        if (!themeButton) return;
        const explicitTheme = document.documentElement.dataset.theme;
        const currentTheme = explicitTheme || (systemTheme.matches ? 'dark' : 'light');
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        const useSystem = Boolean(explicitTheme && nextTheme === (systemTheme.matches ? 'dark' : 'light'));
        const label = useSystem ? `Use system appearance (${nextTheme})` : `Switch to ${nextTheme} appearance`;
        themeButton.dataset.nextTheme = nextTheme;
        themeButton.setAttribute('aria-label', label);
        themeButton.title = label;
      };
      themeButton?.addEventListener('click', () => {
        const explicitTheme = document.documentElement.dataset.theme;
        const currentTheme = explicitTheme || (systemTheme.matches ? 'dark' : 'light');
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        const systemValue = systemTheme.matches ? 'dark' : 'light';
        if (explicitTheme && nextTheme === systemValue) {
          delete document.documentElement.dataset.theme;
          try { localStorage.removeItem('journal-theme'); } catch {}
        } else {
          document.documentElement.dataset.theme = nextTheme;
          try { localStorage.setItem('journal-theme', nextTheme); } catch {}
        }
        updateThemeButton();
      });
      systemTheme.addEventListener?.('change', updateThemeButton);
      updateThemeButton();

      // Keep internal navigation in this tab; open off-site web links separately.
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
        const url = new URL(link.href, window.location.href);
        if ((url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== window.location.origin) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      });

      // Preserve links copied from the HTML prototype, including combined filters.
      if (location.hash.startsWith('#/')) {
        const parts = location.hash.slice(2).split('/');
        let target = '/';
        if (parts[0] === 'thought' && parts[1]) target = `/thought/${parts[1]}/`;
        else if (parts[0] === 'about' || parts[0] === 'now') target = '/about/' + (parts[0] === 'now' ? '#now' : '');
        else if (['journal', 'archive', 'form'].includes(parts[0])) {
          target = parts[1] && parts[1] !== 'all' ? `/journal/${parts[1]}/` : '/';
          if (parts[2]) target += `concept/${parts[2]}/`;
        }
        location.replace(target);
      }
    </script>
  </body>
</html>
