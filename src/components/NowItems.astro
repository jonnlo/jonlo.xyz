---
import { renderNowText } from '../lib/now-rich-text.mjs';
interface Props { items: { label: string; text: string }[]; }
const { items } = Astro.props;
---
<dl class="status-log">{items.map(item => <div><dt>{item.label}</dt><dd class="now-rich-text" set:html={renderNowText(item.text)} /></div>)}</dl>
