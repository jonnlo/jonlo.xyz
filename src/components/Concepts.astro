---
import { archiveHref, type Filter } from '../lib/entries';
import type { Tag } from '../lib/tags';
interface Props { tags: Tag[]; form?: Filter; }
const { tags, form = 'all' } = Astro.props;
---
<div class="record-filing"><span class="record-concepts">{tags.map((tag, index) => <>{index > 0 && <i aria-hidden="true">·</i>}<a href={archiveHref(form, tag.id)}>{tag.name}</a></>)}</span></div>
