---
import { formats, archiveHref, type Filter, type Entry } from '../lib/entries';
interface Props { active: Filter; concept?: string; entries: Entry[]; }
const { active, concept = '', entries } = Astro.props;
---
<nav class="archive-tabs journal-tabs" aria-label="Entry formats">
  {formats.map(([form, label]) => <a class={`tab-${form}`} href={archiveHref(form, concept)} aria-current={form === active ? 'page' : undefined}>{label}<sup>{form === 'all' ? entries.length : entries.filter(entry => entry.data.form === form).length}</sup></a>)}
</nav>
