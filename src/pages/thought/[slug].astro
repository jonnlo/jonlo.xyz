---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormatTabs from '../../components/FormatTabs.astro';
import { publishedEntries, entryTitle, entryHref, archiveHref, formLabel, articleDate, indexDate, recordedTime } from '../../lib/entries';
export async function getStaticPaths() {
  const entries = await publishedEntries();
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const related = entries.filter(other => other.id !== entry.id && other.data.concepts.some(concept => data.concepts.includes(concept))).slice(0, 3);
---
<Base title={entryTitle(entry)} description={data.summary || undefined}>
  <div class={`article-view article-view-${data.form}`}>
    <FormatTabs active={data.form} entries={entries} />
    <article class={`reading reading-${data.form} grid`}>
      <div class:list={['article-content-sheet', { 'has-margin-note': entry.body?.includes('{% marginNote') }]}>
        <header class="article-heading">
          <h1 class:list={{ 'sr-only': data.form === 'crumb' }}>{entryTitle(entry)}</h1>
          <div class="article-meta-line"><span class="article-datetime"><time datetime={data.timestamp || data.date}>{articleDate(data.date)}</time>{data.timestamp && <span>{recordedTime(data.timestamp)}</span>}</span><a class="article-form" href={archiveHref(data.form)}>{formLabel(data.form)}</a></div>
        </header>
        <div class="prose"><Content /></div>
        <div class="article-tags" aria-label="Tags"><span class="article-concepts">{entry.tags.map(tag => <a class="article-concept" href={archiveHref('all', tag.id)}>{tag.name}</a>)}</span></div>
      </div>
      {related.length > 0 && <section class="related"><h2>Related thoughts</h2>{related.map(other => <a class={`related-record related-${other.data.form}`} href={entryHref(other)}><time datetime={other.data.date}>{indexDate(other.data.date)}</time><span>{entryTitle(other)}</span><b>{formLabel(other.data.form)}</b></a>)}</section>}
    </article>
  </div>
</Base>
