---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
const about = await getEntry('about', 'about');
if (!about) throw new Error('About content is missing.');
const { Content } = await render(about);
---
<Base title="About" section="about">
  <section class="support-page about-page about-profile-page">
    <header class="support-heading"><h1>{about.data.heading}</h1></header>
    <div class="support-document"><div class="about-copy about-rich-text"><Content /></div></div>
    <p class="now-history-link about-now-link"><a class="nav-link" href="/now/">What I’m up to now<span aria-hidden="true"> →</span></a></p>
  </section>
</Base>
