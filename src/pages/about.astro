---
import Base from '../layouts/Base.astro';
import about from '../content/about.json';
import { articleDate } from '../lib/entries';
import { publishedNowUpdates } from '../lib/now';
import NowItems from '../components/NowItems.astro';
const latest = (await publishedNowUpdates())[0];
---
<Base title="About" section="about">
  <section class="support-page about-page">
    <header class="support-heading"><h1>{about.heading}</h1></header>
    <div class="support-document"><div class="about-copy">{about.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div></div>
    {latest && <section class="now-section" id="now" aria-labelledby="now-heading">
      <header class="now-heading"><h2 id="now-heading">Now</h2><p class="archive-line"><time datetime={latest.data.date}>{articleDate(latest.data.date)}</time></p></header>
      <NowItems items={latest.data.items} />
      <p class="now-history-link"><a href="/now/">Past updates ↗</a></p>
    </section>}
  </section>
</Base>
