---
import Base from '../layouts/Base.astro';
import NowItems from '../components/NowItems.astro';
import { publishedNowUpdates } from '../lib/now';
import { articleDate } from '../lib/entries';
import nowPage from '../content/now-page.json';
const updates = await publishedNowUpdates();
const latest = updates[0];
---
<Base title="Now" section="now">
  <section class="support-page about-page now-page now-current-page">
    <header class="support-heading"><h1>Now</h1></header>
    <div class="now-intro prose"><p>{nowPage.currentDescription}</p></div>
    {latest && <section class="now-section now-current" aria-labelledby="now-current-heading">
      <header class="now-heading"><h2 class="archive-line" id="now-current-heading"><time datetime={latest.data.date}>{articleDate(latest.data.date)}</time></h2></header>
      <NowItems items={latest.data.items} />
      <p class="now-history-link"><a class="nav-link" href="/now/history/">Past updates<span aria-hidden="true"> →</span></a></p>
    </section>}
    {!latest && <div class="support-document"><p>No updates published yet.</p></div>}
  </section>
</Base>
