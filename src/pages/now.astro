---
import Base from '../layouts/Base.astro';
import NowItems from '../components/NowItems.astro';
import { publishedNowUpdates } from '../lib/now';
import { articleDate } from '../lib/entries';
const updates = await publishedNowUpdates();
---
<Base title="Now history" section="about">
  <section class="support-page about-page">
    <header class="support-heading"><h1>Now, over time.</h1></header>
    <div class="support-document">
      <div class="about-copy"><p>A record of what I’ve been reading, thinking about, working on, and listening to.</p></div>
      <p class="now-history-link now-back-link"><a class="nav-link" href="/about/#now"><span aria-hidden="true">← </span>Back to Now</a></p>
    </div>
    {updates.map(update => <section class="now-section now-history-record" id={`update-${update.id}`} aria-labelledby={`heading-${update.id}`}>
      <header class="now-heading"><h2 class="archive-line now-history-date" id={`heading-${update.id}`}><a href={`#update-${update.id}`}><time datetime={update.data.date}>{articleDate(update.data.date)}</time></a></h2></header>
      <NowItems items={update.data.items} />
    </section>)}
    {updates.length === 0 && <div class="support-document"><p>No updates published yet.</p></div>}
  </section>
</Base>
